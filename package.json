{
  "name": "@kynetis/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run start:dev",
    "prebuild": "npm run build --workspace @kynetis/shared",
    "prestart:dev": "npm run build --workspace @kynetis/shared",
    "start:dev": "nest start --watch --env-file .env --no-shell"
  },
  "dependencies": {
    "@kynetis/shared": "1.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.1",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24"
  }
}
